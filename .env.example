# ─── Supabase Configuration ───
# Get these from: https://supabase.com/dashboard → Project Settings → API Keys

# server/.env
SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (sb_publishable_…). The legacy name SUPABASE_ANON_KEY also works.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_…) — bypasses RLS, never expose to the client
SUPABASE_SECRET_KEY=sb_secret_...
PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# client/.env (everything here ends up in the browser — publishable key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
